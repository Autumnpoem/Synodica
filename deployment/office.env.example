# Copy to /etc/opengrokbot/office.env and keep it private (mode 600).
# Reuse an existing office token when migrating. Never put provider keys in this example.
OPENGROKBOT_TOKEN=REPLACE_WITH_YOUR_PRIVATE_OFFICE_TOKEN
OPENGROKBOT_ALLOWED_ORIGINS=https://office.example.com
# Official CLI executables and logins belong to the service user on the execution host.
# Do not enable a native Electron pet on a headless server.
